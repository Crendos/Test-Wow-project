+// === PLAYERBOTS =========================================================
+// Вход бота персонажем без сокетов: реплика HandleContinuePlayerLogin без SMSG.
+void WorldSession::LoginPlayerBot(ObjectGuid guid)
+{
+    if (PlayerLoading() || GetPlayer())
+        return;
+
+    m_playerLoading = guid;
+    if (!IsLegitCharacterForAccount(guid))
+    {
+        TC_LOG_ERROR("playerbots", "LoginPlayerBot: персонаж {} не принадлежит аккаунту {}", guid.ToString(), GetAccountId());
+        m_playerLoading.Clear();
+        return;
+    }
+
+    std::shared_ptr<LoginQueryHolder> holder = std::make_shared<LoginQueryHolder>(GetAccountId(), m_playerLoading);
+    if (!holder->Initialize())
+    {
+        TC_LOG_ERROR("playerbots", "LoginPlayerBot: не удалось инициализировать LoginQueryHolder для {}", guid.ToString());
+        m_playerLoading.Clear();
+        return;
+    }
+
+    AddQueryHolderCallback(CharacterDatabase.DelayQueryHolder(holder)).AfterComplete([this](SQLQueryHolderBase const& holderDone)
+    {
+        HandlePlayerLogin(static_cast<LoginQueryHolder const&>(holderDone));
+    });
+}
